# ============================================
# 只上传 backend 和 frontend 两个文件夹
# ============================================

# 忽略根目录下所有文件和文件夹
*

# 允许上传 backend 和 frontend
!backend/
!frontend/

# 允许上传 .gitignore 本身
!.gitignore

# ============================================
# backend 内部忽略
# ============================================
backend/target/
backend/.idea/
backend/*.iml
backend/.classpath
backend/.project
backend/.settings/
backend/.vscode/

# ============================================
# frontend 内部忽略
# ============================================
frontend/node_modules/
frontend/dist/
frontend/.vscode/

# ============================================
# 通用忽略
# ============================================
**/application.yml
**/application.yaml
*.class
*.log
*.jar
*.war
hs_err_pid*
.DS_Store
Thumbs.db
